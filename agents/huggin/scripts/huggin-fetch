#!/usr/bin/env python3

from __future__ import annotations

import argparse
import ipaddress
import re
import socket
import sys

from html.parser import HTMLParser
from urllib.parse import urlparse
from urllib.request import (
    HTTPRedirectHandler,
    Request,
    build_opener,
)


def validate_public_url(value: str) -> None:
    parsed = urlparse(value)

    if (
        parsed.scheme not in {"http", "https"}
        or not parsed.hostname
    ):
        raise ValueError(
            "Only public http:// and https:// URLs "
            "are supported."
        )

    port = parsed.port or (
        443
        if parsed.scheme == "https"
        else 80
    )

    for result in socket.getaddrinfo(
        parsed.hostname,
        port,
        type=socket.SOCK_STREAM,
    ):
        address = ipaddress.ip_address(
            result[4][0]
        )

        if not address.is_global:
            raise ValueError(
                "Private, local, reserved, and "
                "link-local addresses are blocked."
            )


class PublicRedirectHandler(
    HTTPRedirectHandler
):

    def redirect_request(
        self,
        request,
        file_pointer,
        code,
        message,
        headers,
        new_url,
    ):
        validate_public_url(new_url)
        return super().redirect_request(
            request,
            file_pointer,
            code,
            message,
            headers,
            new_url,
        )


class ReadableTextParser(HTMLParser):

    BLOCKED_TAGS = {
        "script",
        "style",
        "noscript",
        "svg",
    }

    def __init__(self) -> None:
        super().__init__()
        self._blocked_depth = 0
        self._parts: list[str] = []

    def handle_starttag(
        self,
        tag: str,
        attrs: list[tuple[str, str | None]],
    ) -> None:
        if tag in self.BLOCKED_TAGS:
            self._blocked_depth += 1
        elif tag in {"br", "p", "div", "article", "section", "li", "h1", "h2", "h3"}:
            self._parts.append("\n")

    def handle_endtag(self, tag: str) -> None:
        if tag in self.BLOCKED_TAGS and self._blocked_depth:
            self._blocked_depth -= 1
        elif tag in {"p", "div", "article", "section", "li"}:
            self._parts.append("\n")

    def handle_data(self, data: str) -> None:
        if not self._blocked_depth:
            self._parts.append(data)

    def text(self) -> str:
        joined = " ".join(self._parts)
        joined = re.sub(r"[ \t\r\f\v]+", " ", joined)
        joined = re.sub(r" *\n *", "\n", joined)
        joined = re.sub(r"\n{3,}", "\n\n", joined)
        return joined.strip()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Fetch a public HTTP(S) page and print readable text. "
            "Prefer OpenClaw web_fetch when available."
        )
    )
    parser.add_argument("url")
    parser.add_argument("--max-bytes", type=int, default=2_000_000)
    parser.add_argument("--timeout", type=float, default=20.0)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        validate_public_url(args.url)
    except (ValueError, OSError) as exc:
        raise SystemExit(str(exc)) from exc

    if args.max_bytes < 1:
        raise SystemExit("--max-bytes must be positive.")

    request = Request(
        args.url,
        headers={
            "User-Agent": "Huggin-Research/1.0",
        },
    )

    opener = build_opener(
        PublicRedirectHandler()
    )

    try:
        with opener.open(
            request,
            timeout=args.timeout,
        ) as response:
            payload = response.read(args.max_bytes + 1)
            content_type = response.headers.get_content_type()
            charset = response.headers.get_content_charset() or "utf-8"
    except Exception as exc:
        print(f"Fetch failed: {exc}", file=sys.stderr)
        return 1

    if len(payload) > args.max_bytes:
        raise SystemExit(
            f"Response exceeded --max-bytes ({args.max_bytes})."
        )

    decoded = payload.decode(charset, errors="replace")

    if content_type in {"text/html", "application/xhtml+xml"}:
        parser = ReadableTextParser()
        parser.feed(decoded)
        print(parser.text())
    else:
        print(decoded)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
