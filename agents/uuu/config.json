{
    "schema_version": 1,
    "kind": "agent-config",
    "name": "uuu",
    "user": "uuu",
    "model": "openai/gpt-5.6-sol",
    "default": true,
    "gateway_host": "127.0.0.1",
    "gateway_port": 18789,
    "execution": {
        "backend": "agent-executor",
        "required": true,
        "timeout_seconds": 300
    },
    "tools": {
        "profile": "coding",
        "also_allow": ["agent_exec"],
        "deny": ["exec", "process"]
    },
    "bootstrap": [
        {
            "name": "message_listening",
            "flags": [
                {"flag": "--agent", "value": "mimir"},
                {"flag": "--topic", "value": "mimir"},
                {"flag": "--wakeup-socket", "value": "/run/agents_manager/control.sock"},
                {"flag": "--verbose"}
            ]
        }
    ]
}
