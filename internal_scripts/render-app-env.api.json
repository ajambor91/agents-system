      "takes_value": true
    },
    {
      "name": "user_group",
      "short": null,
      "long": "--user-group",
      "required": false,
      "takes_value": true
    },
    {
      "name": "user_system_home",
      "short": null,
      "long": "--user-system-home",
      "required": false,
      "takes_value": true
    },
    {
      "name": "config_dir",
      "short": null,
      "long": "--config-dir",
      "required": false,
      "takes_value": true
    },
    {
      "name": "data_dir",
      "short": null,
      "long": "--data-dir",
      "required": false,
      "takes_value": true
    },
    {
      "name": "runtime_dir",
      "short": null,
      "long": "--runtime-dir",
      "required": false,
