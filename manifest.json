{
  "schema_version": 1,
  "version": "0.0.2",
  "kind": "repository-manifest",
  "absolute_repo_dir": "/home/user-system/repositories/agents-system",
  "repository": {
    "name": "agents-system",
    "purpose": "Define and run shared local infrastructure for repositories and AI agents.",
    "status": "implemented"
  },
  "application": {
    "language": "python",
    "entrypoint": "src/agents_system/__main__.py",
    "resident_handler": "Application",
    "one_command_per_class": true,
    "public_methods": [
      "modules"
    ]
  },
  "applications": [
    {
      "id": "agents_system",
      "entrypoint": "src/agents_system/__main__.py",
      "status": "implemented",
      "role": "control-plane",
      "console_commands": [
        {
          "section": "system",
          "command": "modules",
          "method": "modules",
          "flags": [
            "--installed",
            "--running"
          ]
        }
      ]
    },
    {
      "id": "runtime",
      "entrypoint": "src/_runtime/__main__.py",
      "status": "implemented",
      "role": "resident-runtime"
    },
    {
      "id": "agents_data_runtime",
      "entrypoint": "src/agents_data_runtime/__main__.py",
      "status": "migrated",
      "role": "agent-communication-runtime"
    },
    {
      "id": "agents_system_cli",
      "entrypoint": "src/agents_system_cli/__main__.py",
      "status": "implemented",
      "role": "console-api"
    },
    {
      "id": "agents_manager",
      "entrypoint": "src/agents_manager/__main__.py",
      "status": "migrated",
      "role": "desktop"
    },
    {
      "id": "agents_data",
      "entrypoint": "src/agents_data/__main__.py",
      "status": "migrated",
      "role": "local-data-client"
    },
    {
      "id": "agents_data_backend",
      "entrypoint": "src/agents_data_backend/__main__.py",
      "status": "scaffold",
      "role": "data-backend"
    }
  ],
  "architecture": {
    "document": "ARCHITECTURE.md",
    "merge_plans": [
      "AGENT_MANAGER_MERGE.md",
      "COMMUNICATION_STACK_MERGE.md"
    ]
  },
  "system": true,
  "commands": [
    "asystem",
    "asystem-uninstall",
    "asystem-reinstall",
    "asystem-reconfigure"
  ],
  "lifecycle": {
    "entrypoint": "src/install/__main__.py",
    "source": "install/src",
    "parent": "InstallerParent",
    "confirmation_flag": "--yes",
    "help_manifests": "install/src/resources/*.json",
    "commands": {
      "asystem-uninstall": {
        "wrapper": "host_scripts/asystem-uninstall.sh",
        "contract": "install/src/resources/uninstaller.json"
      },
      "asystem-reinstall": {
        "wrapper": "host_scripts/asystem-reinstall.sh",
        "contract": "install/src/resources/reinstaller.json"
      },
      "asystem-reconfigure": {
        "wrapper": "host_scripts/asystem-reconfigure.sh",
        "contract": "install/src/resources/reconfigure.json"
      }
    }
  }
}
