{
  "schema_version": 1,
  "command": "app-add",
  "mode": "write",
  "host_script": "host_scripts/asystem-app-add.sh",
  "description": "Rejestruje moduł aplikacji w rezydentnym runtime.",
  "usage": "asystem_app_add --repo-name NAME [--repository-path PATH] [--entrypoint PATH] [--start]",
  "target": {"application": "Application", "command_class": "AppAdd", "method": "execute"},
  "flags": [
    {"short": "-r", "long": "--repo-name", "destination": "name", "required": true, "takes_value": true, "type": "string", "description": "Identyfikator repozytorium/modułu."},
    {"short": null, "long": "--repository-path", "required": false, "takes_value": true, "type": "path", "default": null, "description": "Jawna ścieżka checkoutu."},
    {"short": null, "long": "--repo-path", "destination": "repository_path", "required": false, "takes_value": true, "type": "path", "default": null, "description": "Alias ścieżki checkoutu."},
    {"short": null, "long": "--entrypoint", "required": false, "takes_value": true, "type": "path", "default": null, "description": "Jawny entrypoint Pythona."},
    {"short": null, "long": "--start", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Uruchom runtime po rejestracji."},
    {"short": "-h", "long": "--help", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Wyświetl pomoc bez skutków ubocznych."}
  ],
  "steps": ["validate-repository", "discover-entrypoint", "write-registry", "optionally-start-runtime"],
  "outputs": ["registered-module-json"]
}
