    },
    {
      "short": null,
      "long": "--yes",
      "required": false,
      "takes_value": false,
      "type": "boolean",
      "default": false,
      "description": "Jawne potwierdzenie operacji."
    },
    {
      "short": "-h",
      "long": "--help",
      "required": false,
      "takes_value": false,
      "type": "boolean",
      "default": false,
      "description": "Wyświetl pomoc."
    }
