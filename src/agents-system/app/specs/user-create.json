{
  "schema_version": 1,
  "command": "user-create",
  "mode": "write",
  "host_script": "host_scripts/ausers-create.sh",
  "description": "Tworzy konto i katalogi użytkownika systemowego.",
  "usage": "ausers_create [--user NAME] --yes",
  "target": {
    "application": "Application",
    "command_class": "UserCreate",
    "method": "execute"
  },
  "flags": [
    {
      "short": "-u",
      "long": "--user",
      "required": false,
      "takes_value": true,
      "type": "string",
