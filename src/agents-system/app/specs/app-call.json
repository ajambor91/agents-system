{
  "schema_version": 1, "command": "app-call", "mode": "write",
  "host_script": "host_scripts/asystem-app-call.sh",
  "description": "Wysyła obiekt JSON do zarejestrowanego modułu runtime.",
  "usage": "asystem_app_call --name NAME [--payload JSON]",
  "target": {"application": "Application", "command_class": "AppCall", "method": "execute"},
  "flags": [
    {"short": "-n", "long": "--name", "required": true, "takes_value": true, "type": "string", "description": "Nazwa modułu."},
    {"short": "-p", "long": "--payload", "required": false, "takes_value": true, "type": "json", "default": {}, "description": "Obiekt JSON przekazywany do modułu."},
    {"short": "-h", "long": "--help", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Wyświetl pomoc."}
  ],
  "steps": ["validate-json", "connect-unix-socket", "send-request", "render-response"],
  "outputs": ["runtime-response-json"]
}
