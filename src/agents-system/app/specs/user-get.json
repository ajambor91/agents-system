{
  "schema_version": 1, "command": "user-get", "mode": "read", "host_script": "host_scripts/ausers-get.sh",
  "description": "Odczytuje dane użytkownika systemowego.", "usage": "ausers_get [--user NAME] [--home | --name | --group]",
  "target": {"application": "Application", "command_class": "UserGet", "method": "execute"},
  "flags": [
    {"short": "-u", "long": "--user", "required": false, "takes_value": true, "type": "string", "default": null, "description": "Nazwa użytkownika."},
    {"short": null, "long": "--home", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Wypisz tylko katalog domowy."},
    {"short": "-n", "long": "--name", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Wypisz tylko nazwę."},
    {"short": "-g", "long": "--group", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Wypisz tylko grupę."},
    {"short": "-h", "long": "--help", "required": false, "takes_value": false, "type": "boolean", "default": false, "description": "Wyświetl pomoc."}
  ],
  "exclusive_groups": [{"members": ["home", "name", "group"], "minimum": 0, "maximum": 1}],
  "steps": ["resolve-user", "read-account"], "outputs": ["user-value-or-json"]
}
