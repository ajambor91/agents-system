{
  "schema_version": 1,
  "command": "env-init",
  "mode": "write",
  "host_script": "host_scripts/asystem-env-init.sh",
  "description": "Waliduje, zapisuje i publikuje konfigurację środowiska Agents System.",
  "usage": "asystem_env_init (--default | --file PATH | --interactive) [--force]",
  "target": {
    "application": "Application",
    "command_class": "EnvInit",
    "method": "execute"
  },
  "flags": [
    {
      "short": "-d",
      "long": "--default",
      "required": false,
      "takes_value": false,
      "type": "boolean",
      "default": false,
      "description": "Użyj wersjonowanego app_env.template.json."
    },
    {
      "short": "-f",
      "long": "--file",
      "required": false,
      "takes_value": true,
      "type": "path",
      "default": null,
      "description": "Użyj wskazanego dokumentu JSON."
    },
    {
      "short": "-i",
      "long": "--interactive",
      "required": false,
      "takes_value": false,
      "type": "boolean",
      "default": false,
      "description": "Zapytaj o wartości w terminalu."
    },
    {
      "short": null,
      "long": "--force",
      "required": false,
      "takes_value": false,
      "type": "boolean",
      "default": false,
      "description": "Zastąp istniejący zwykły plik centralny."
    },
    {
      "short": "-h",
      "long": "--help",
      "required": false,
      "takes_value": false,
      "type": "boolean",
      "default": false,
      "description": "Wyświetl pomoc bez zapisu."
    }
  ],
  "exclusive_groups": [
    {
      "members": [
        "default",
        "file",
        "interactive"
      ],
      "minimum": 1,
      "maximum": 1
    }
  ],
  "steps": [
    "select-source",
    "validate-schema",
    "resolve-placeholders",
    "atomic-local-write",
    "link-central-file",
    "write-shell-exports",
    "load-process-environment"
  ],
  "outputs": [
    "resources/app_env.json",
    "APP_ENV_PATH",
    "APP_CONFIG_DIR/environment.sh"
  ]
}
